<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.tvh</groupId>
  <artifactId>homestay</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>homestay-tvh</name>
  <description>Website giới thiệu và đặt phòng Homestay TVH</description>

  <properties>
    <java.version>21</java.version>
    <!-- Khai báo đủ dependency của cả 9 phase ngay từ đầu. Thêm dần sẽ khiến
         mỗi phase phải dừng lại sửa pom. -->
    <springdoc.version>2.8.13</springdoc.version>
    <bucket4j.version>8.14.0</bucket4j.version>
    <cloudinary.version>1.39.0</cloudinary.version>
    <twelvemonkeys.version>3.12.0</twelvemonkeys.version>
    <owasp-sanitizer.version>20240325.1</owasp-sanitizer.version>
    <mapstruct.version>1.6.3</mapstruct.version>
  </properties>

  <dependencies>
    <!-- ─── Web & nền tảng ─────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ─── Bảo mật (Phase 4) ──────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <!-- Ký và đọc JWT bằng chính thư viện của Spring Security (Nimbus) thay vì
         thêm một thư viện JWT bên thứ ba. Phiên bản do Spring Boot BOM quản lý,
         và JwtEncoder/JwtDecoder ghép thẳng vào chuỗi filter đã có. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>

    <!-- ─── Dữ liệu (Phase 3) ──────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ─── Email qua hộp thư đi (Phase 6) ─────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>

    <!-- ─── Lưu ảnh (Phase 7) ──────────────────────────────────────────── -->
    <dependency>
      <groupId>com.cloudinary</groupId>
      <artifactId>cloudinary-http44</artifactId>
      <version>${cloudinary.version}</version>
    </dependency>

    <!--
      Bộ đọc WebP cho ImageIO. Java SE KHÔNG đọc được WebP, nên không có thư
      viện này thì ImageValidator chỉ có hai lựa chọn cho một tệp .webp: từ
      chối nó (trái với danh sách trắng đã chốt), hoặc cho đi qua mà không giải
      mã lại — tức là mất đúng lớp phòng thủ chống tệp polyglot. Bộ đọc này chỉ
      ĐỌC; ảnh WebP hợp lệ được ghi lại thành PNG.
    -->
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-webp</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>

    <!-- ─── Sanitize HTML cho nội dung CMS (Phase 8) ───────────────────── -->
    <dependency>
      <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
      <artifactId>owasp-java-html-sanitizer</artifactId>
      <version>${owasp-sanitizer.version}</version>
    </dependency>

    <!-- ─── Tài liệu API (Phase 9) ─────────────────────────────────────── -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- ─── Tiện ích ───────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>

    <!-- ─── Kiểm thử ───────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers: bắt buộc dùng Postgres thật. H2 không có daterange
         lẫn EXCLUDE, nên test trên H2 sẽ xanh giả. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
          <!-- Múi giờ phải đặt ở tầng JVM. spring.jackson.time-zone chỉ chi
               phối serialize JSON; nó không đổi TimeZone.getDefault(), không
               ảnh hưởng LocalDate.now() và không ảnh hưởng session timezone
               của JDBC. -->
          <jvmArguments>-Duser.timezone=Asia/Ho_Chi_Minh</jvmArguments>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Duser.timezone=Asia/Ho_Chi_Minh</argLine>
          <!-- Mặc định surefire chỉ nhận *Test/Test*/*Tests, nên lớp có hậu tố
               IT bị bỏ qua IM LẶNG: `mvn test` báo xanh trong khi những test
               quan trọng nhất chưa hề chạy. Ở dự án này mọi test đều cần
               Docker như nhau, không có lý do tách hai vòng chạy. -->
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
