# Sao chép thành .env rồi điền giá trị. KHÔNG commit .env.
#
# Không biến nào ở đây có giá trị mặc định trong mã nguồn. Ứng dụng dừng khởi
# động khi thiếu biến bắt buộc, ở mọi profile. Repo này công khai, nên một giá
# trị mặc định "an toàn cho demo" nằm trong repo đồng nghĩa với việc bất kỳ ai
# cũng tự ký được token quản trị cho mọi bản triển khai dùng repo này.

# ─── Cơ sở dữ liệu ───────────────────────────────────────────────────────────
DB_URL=
DB_USER=
DB_PASSWORD=

# ─── Bí mật bắt buộc ─────────────────────────────────────────────────────────
# Sinh bằng: openssl rand -base64 48
JWT_SECRET=
# Khoá SePay dùng để xác thực webhook. Sinh bằng: openssl rand -hex 32
SEPAY_WEBHOOK_API_KEY=

# ─── SePay / VietQR (Phase 6) ────────────────────────────────────────────────
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=

# ─── Cloudinary (Phase 7) ────────────────────────────────────────────────────
# Bỏ trống thì hệ thống dùng LocalImageStorage ghi vào uploads/
CLOUDINARY_URL=

# ─── SMTP (Phase 6) ──────────────────────────────────────────────────────────
# Bỏ trống thì hệ thống dùng LoggingMailSender; hộp thư đi vẫn được ghi nhận
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── Múi giờ ─────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh
