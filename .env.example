# Danh sách TÊN biến môi trường. Mọi giá trị ở đây đều TRỐNG, có chủ ý.
#
# Không biến nào có giá trị mặc định trong mã nguồn. Ứng dụng dừng khởi động khi
# thiếu biến bắt buộc, ở mọi profile. Repo này công khai, nên một giá trị mặc
# định "an toàn cho demo" nằm trong repo đồng nghĩa với việc bất kỳ ai cũng tự
# ký được token quản trị cho mọi bản triển khai dùng repo này.
#
# ĐỪNG sao chép tệp này thành .env rồi điền tay. Chạy:
#
#     ./scripts/init-env.sh
#
# Script đó sinh bí mật ngẫu nhiên và KHÔNG đọc gì từ tệp này.

# ═══ Đường chạy bằng Docker (docker-compose.yml) ═════════════════════════════
# init-env.sh sinh đúng nhóm này. docker-compose.yml tự ghép DB_URL từ chúng.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Cổng công khai. Đổi khi cổng 80 / 8025 đã có thứ khác chiếm.
WEB_PORT=
MAILPIT_PORT=

# Profile: `demo` (có dữ liệu mẫu và Swagger) hoặc `prod`. Bỏ trống thì
# docker-compose.yml dùng `demo`.
SPRING_PROFILES_ACTIVE=

# ═══ Đường chạy thủ công (mvn spring-boot:run) ═══════════════════════════════
# Khi chạy backend trực tiếp trên máy, khai ba biến này thay cho nhóm POSTGRES_*.
DB_URL=
DB_USER=
DB_PASSWORD=

# ═══ Bí mật bắt buộc — cả hai đường chạy ═════════════════════════════════════
# Sinh bằng: openssl rand -base64 48
JWT_SECRET=
# Khoá SePay dùng để xác thực webhook. Sinh bằng: openssl rand -hex 32
SEPAY_WEBHOOK_API_KEY=

# ═══ SePay / VietQR ══════════════════════════════════════════════════════════
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=

# ═══ Cloudinary ══════════════════════════════════════════════════════════════
# Bỏ trống thì hệ thống dùng LocalImageStorage ghi vào thư mục STORAGE_LOCAL_DIR.
CLOUDINARY_URL=
STORAGE_LOCAL_DIR=

# ═══ SMTP ════════════════════════════════════════════════════════════════════
# Bỏ trống thì hệ thống dùng LoggingMailSender; hộp thư đi vẫn được ghi nhận.
# Bản Docker trỏ sẵn sang Mailpit, không cần khai ở đây.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# ═══ Múi giờ ═════════════════════════════════════════════════════════════════
TZ=
